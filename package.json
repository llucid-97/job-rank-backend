{
  "name": "job-rank-backend",
  "version": "1.0.0",
  "description": "Backend API for the Job Rank applications",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --import tsx --import ./tests/setup-env.ts --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:database": "node --test --test-concurrency=1 tests/candidate-document.database.mjs tests/job-workspace.database.mjs"
  },
  "keywords": [
    "job-ranking",
    "express",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@supabase/server": "^1.5.2",
    "@supabase/supabase-js": "^2.114.0",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.5",
    "pg": "8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
